# ============================================================
# YMONEY configuration example. Copy to .env and adjust.
# NEVER commit real .env files or API keys.
# ============================================================

# ---- Core ----
YMONEY_ENV=development                 # development | production
YMONEY_SECRET_KEY=change-me-to-a-long-random-string
YMONEY_HOST=127.0.0.1
YMONEY_PORT=8100
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public base URL — used to build OAuth redirect URIs. Must match the URI
# registered in your Google Cloud OAuth client for YouTube connects.
YMONEY_PUBLIC_BASE_URL=http://127.0.0.1:8100
# Production TLS (Caddy): set the public domain and contact email, then
# uncomment the TLS block in deploy/Caddyfile.
# YMONEY_DOMAIN=videos.example.com
# YMONEY_TLS_EMAIL=ops@example.com

# ---- Database ----
# SQLite by default (file created automatically). For Postgres:
# DATABASE_URL=postgresql+psycopg://ymoney:secret@localhost:5432/ymoney
DATABASE_URL=sqlite:///./data/ymoney.db

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Video engine ----
# ffmpeg_avatar (default — fully local real render: stock clips, word-timed
# captions, BGM bed) | moneyprinterturbo (external MPT service) | mock
VIDEO_ENGINE=ffmpeg_avatar
# Only used when VIDEO_ENGINE=moneyprinterturbo:
MPT_BASE_URL=http://127.0.0.1:8081
MPT_TIMEOUT_SECONDS=1800

# ---- LLM provider (OpenAI-compatible) — REQUIRED for production ----
# Configure in-app under Settings → Connections (encrypted at rest); these env
# values act as fallback. There is NO mock mode: without a real key the
# readiness gate blocks autonomous production with explicit remediation.
# Examples: OpenAI, OpenRouter (https://openrouter.ai/api/v1, model
# "openrouter/free" auto-routes to the best free model), xkiro, DeepSeek.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=

# ---- Trend sources ----
GOOGLE_TRENDS_ENABLED=true             # public RSS, no key required
TREND_REFRESH_MINUTES=30
# Keyless social listening (no config needed; add via Settings → Trends)
# kinds: google_trends | reddit | hacker_news | newsdata
# NewsData.io structured news source (from the public-apis catalog) — free tier:
# 200 credits/day, 10 articles/request. Auto-joins discovery when a key is set.
NEWSDATA_API_KEY=

# ---- TTS (narration) ----
TTS_PROVIDER=edge                      # edge | kokoro | mock
# Optional fully-local neural TTS (Kokoro-82M, Apache-2 weights) behind any
# OpenAI-compatible /audio/speech server, e.g. kokoro-fastapi on :8880:
KOKORO_BASE_URL=

# ---- Scene visuals ----
# pexels — real stock photography (set PEXELS_API_KEY, free at pexels.com/api)
# xkiro | pollinations | openai_compat — AI-generated imagery
# mock — labeled placeholder (simulation only)
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=

# ---- Telegram remote control (optional) ----
# Control YMONEY from your phone: pair a chat in Settings → Integrations,
# then use /status /run /stop /pause /resume /cycle /cost in Telegram.
# The token can also be set at runtime in Settings → Connections (encrypted).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
TELEGRAM_POLL_INTERVAL_SECONDS=3

# ---- Publishing (official APIs via Upload-Post relay or direct OAuth) ----
UPLOAD_POST_API_KEY=
UPLOAD_POST_USERNAME=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Cost control ----
DAILY_BUDGET_USD=5.00
PER_VIDEO_BUDGET_USD=0.50

# ---- Autopilot defaults ----
AUTOPILOT_MAX_CYCLES=0                 # 0 = unlimited
AUTOPILOT_VIDEOS_PER_CYCLE=1
QUALITY_THRESHOLD=75

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Storage (local default; set STORAGE_BACKEND=s3 + bucket for scale-out) ----
# STORAGE_BACKEND=local                  # local | s3
# S3_ENDPOINT_URL=                        # e.g. https://minio:9000 or R2 endpoint
# S3_BUCKET=ymoney-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=                     # CDN base serving the bucket (enables IG direct)

# ---- Observability ----
# SENTRY_DSN=
