# MoneyPrinterTurbo runtime artifacts
MoneyPrinterTurbo/storage/
# MoneyPrinterTurbo real config carries live API keys — never commit it
MoneyPrinterTurbo/config.toml

# Local runtime data (videos, renders, task state)
data/
*.log
backend-dev.log
frontend-dev.log
frontend.log
mpt.log
server.log
server.err.log

# Vendored MoneyPrinterTurbo: code only; heavy stock assets stay out of git
MoneyPrinterTurbo/resource/
MoneyPrinterTurbo/storage/
MoneyPrinterTurbo/config.toml
MoneyPrinterTurbo/.venv/
MoneyPrinterTurbo/__pycache__/
MoneyPrinterTurbo/.git.disabled/

# TypeScript incremental build cache (regenerated on every build)
frontend/tsconfig.tsbuildinfo

# Playwright run artefacts (screenshots/traces on failure)
frontend/test-results/
frontend/playwright-report/

# Browser authentication is runtime-only, including developer storage snapshots.
**/.auth/
**/storage-state*.json
**/playwright-storage-state*.json
